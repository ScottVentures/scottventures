# Copy this file to .env and fill in real values.
# .env is gitignored — it will never be committed or pushed to GitHub.
# Never put real secrets directly in config.js or any other source file.

# --- Outgoing email (contact form notifications + replies) ---
# Leave these blank/unset and the site still works — messages just
# save to the database without emailing anyone.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER is
# your address, SMTP_PASS is a 16-character "App Password" — NOT your
# normal Google password. Generate one at:
# https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where contact-form notifications get sent. Defaults to SMTP_USER if unset.
OWNER_EMAIL=

# --- Admin accounts ---
# Comma-separated list of emails that get admin access (contact inbox,
# user management, admin-badged comments) once they register/log in
# with a matching email. No separate password needed beyond their
# normal account login.
ADMIN_EMAILS=johnniekips@gmail.com,scottechstar@gmail.com

# --- Misc ---
# Secret typed when replying to a comment as the owner — unused now
# that admin status comes from being logged in as an ADMIN_EMAILS
# account, but kept for backward compatibility. Change it anyway.
OWNER_REPLY_KEY=change-this-before-using

SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
